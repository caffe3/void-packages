# Template file for 'bitwuzla'
pkgname=bitwuzla
version=0.7.0
revision=1
build_style=meson
configure_args="-Ddefault_library=shared -Dpython=true -Ddocs=false
 -Dfpexp=true -Dkissat=false -Dtesting=disabled --buildtype=release"
hostmakedepends="cmake pkg-config git python3-Cython python3-devel python3-pytest"
# doxygen python3-Sphinx python3-breathe python3-pytest python3-sphinx_rtd_theme python3-sphinx-tabs python3-sphinxcontrib-bibtex
makedepends="gmpxx-devel gmp-devel cadical-devel symfpu-cvc5-git-devel gtest-devel python3-devel"
short_desc="SMT solver for bit-vectors, FP, arrays and uninterpreted functions"
maintainer="Tai Chi Minh Ralph Eastwood <caffe@disroot.org>"
license="MIT"
homepage="https://bitwuzla.github.io"
distfiles="https://github.com/bitwuzla/bitwuzla/archive/refs/tags/${version}.tar.gz"
checksum="4a388aa935fab5fe3e61494f94c1110653ac11e07f1cf29593d6fdba30238afa"
python_version=3
make_check=no

post_install() {
	vlicense COPYING
	vdoc CONTRIBUTING.md
	vdoc NEWS.md
}

