bitwuzla-libs_package() {
	short_desc+=" - runtime libraries"
	pkg_install() {
		vmove usr/lib/*.so*
	}
}

bitwuzla-devel_package() {
	depends="${sourcepkg}-libs>=${version}_${revision}"
	short_desc+=" - development files"
	pkg_install() {
		vmove usr/include
	}
}

bitwuzla-python_package() {
	depends="python3 ${sourcepkg}>=${version}"
	short_desc+=" - Python bindings"
	pkg_install() {
		vmove "${py3_lib}"
	}
}
