# Template file for 'kissat'
pkgname=kissat
version=4.0.2
revision=1
build_style=configure
configure_args="-shared --kitten"
make_check_target="test"
short_desc="Keep it simple and clean bare metal SAT solver written in C"
maintainer="Tai Chi Minh Ralph Eastwood <caffe@disroot.org>"
license="MIT"
homepage="https://fmv.jku.at/kissat"
distfiles="https://github.com/arminbiere/kissat/archive/refs/tags/rel-${version}.tar.gz"
checksum="a8e58a70ebac09ccc0ba1465a69cfb9b31e562167d42df7535270d2733c386d7"

do_install() {
	vbin build/kissat
	vbin build/kitten kissat-kitten # conflicts with kitty-kitten

	vinstall build/libkissat.so 755 usr/lib
	vlicense LICENSE

	cd ${wrksrc}/src
	for f in $(find . -name '*.h'); do
		vinstall ${f} 644 usr/include/${pkgname}/${f%/*}
	done
}

kissat-libs_package() {
	short_desc+=" - runtime libraries"
	pkg_install() {
		vmove usr/lib/*.so*
	}
}

kissat-devel_package() {
	depends="${sourcepkg}-libs>=${version}_${revision}"
	short_desc+=" - development files"
	pkg_install() {
		vmove usr/include
	}
}
